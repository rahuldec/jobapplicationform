// Recruitment Operations Portal — data model
//
// Design principles (do not violate these when extending the schema):
// 1. Every tenant-scoped row carries `tenantId` and every query must filter by it.
//    There is no cross-tenant relation anywhere in this file.
// 2. Nothing that represents an admin *decision* (form fields, export
//    columns, workflow stages) is a hard-coded enum tied to a domain concept
//    like "qualification" or "experience". Those are rows the admin creates,
//    not columns the schema defines.
// 3. Status/type/role "enums" are plain strings validated in the
//    application layer (see src/lib/enums.ts), not Prisma enums — this keeps
//    the schema portable between SQLite (dev) and PostgreSQL (prod) without
//    behavioral differences, and keeps new admin-defined values from
//    requiring a migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  brandingJson String? // logo url, colors, letterhead config — admin-defined

  // Per-tenant Google Sheet source, so the sync engine (prisma/sheet-import)
  // is generic across clients instead of hardcoded to one Sheet's column
  // layout. sheetMappingJson parses to the SheetImportConfig type in
  // prisma/sheet-import/types.ts — sections/fields/documents/core-field
  // columns/job-title template, all admin-defined per tenant.
  sheetSourceUrl   String?
  sheetMappingJson String?

  // Per-tenant email sent to the candidate when their interview is
  // scheduled/rescheduled — {placeholder} templated, see
  // src/lib/email.ts. Both null means the built-in default wording is
  // used, so a tenant works with zero setup until they want to customize it.
  interviewEmailSubject String?
  interviewEmailBody    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departments      Department[]
  users            User[]
  jobs             Job[]
  candidates       Candidate[]
  applications     Application[]
  documents        Document[]
  applicationForms ApplicationForm[]
  interviews       Interview[]
  auditLogs        AuditLog[]

  @@map("tenants")
}

model Department {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  code String?

  jobs Job[]

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

// Staff user. No login/session is implemented yet (deferred per product
// decision), but role + tenant scoping is modeled now so authorization can
// be added later without a schema rework.
model User {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String
  email String @unique
  role  String // super_admin | college_admin | recruiter | panel_member — see src/lib/enums.ts

  createdAt DateTime @default(now())

  assignedApplications Application[]  @relation("AssignedRecruiter")
  auditLogs            AuditLog[]

  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Dynamic application form (per tenant, reusable across jobs)
// ---------------------------------------------------------------------------

model ApplicationForm {
  id          String @id @default(cuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections FormSection[]
  jobs     Job[]

  @@index([tenantId])
  @@map("application_forms")
}

model FormSection {
  id     String @id @default(cuid())
  formId String
  form   ApplicationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  name  String
  order Int

  fields FormField[]

  @@index([formId])
  @@map("form_sections")
}

// A single field the admin has added to the form builder.
// `fieldKey` is the stable machine name referenced by export mappings and
// synopsis templates — it must be unique within a form and must never be
// silently reused for a different meaning once exports reference it.
model FormField {
  id        String @id @default(cuid())
  sectionId String
  section   FormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  fieldKey String
  label    String
  helpText String?

  fieldType    String // text | textarea | number | date | email | phone | select | multiselect | radio | checkbox | file | yes_no — see src/lib/enums.ts
  optionsJson  String? // for select/multiselect/radio: [{ "value": "...", "label": "..." }]
  required     Boolean @default(false)
  validationJson String? // { min, max, pattern, ... } — admin-defined, generic
  order        Int

  values ApplicationFieldValue[]

  @@unique([sectionId, fieldKey])
  @@index([sectionId])
  @@map("form_fields")
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

model Job {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  title              String
  code               String?
  description        String?
  employmentType     String? // free text / admin-defined, e.g. "Assistant Professor - Regular"
  numberOfPositions  Int      @default(1)
  status             String   @default("draft") // draft | published | closed — see src/lib/enums.ts
  applicationDeadline DateTime?

  formId String?
  form   ApplicationForm? @relation(fields: [formId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  applications Application[]

  @@index([tenantId])
  @@index([departmentId])
  @@map("jobs")
}

// ---------------------------------------------------------------------------
// Candidates & Applications
// ---------------------------------------------------------------------------

model Candidate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fullName    String
  email       String
  mobile      String?
  dateOfBirth DateTime?
  gender      String?

  createdAt DateTime @default(now())

  applications Application[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("candidates")
}

model Application {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  applicationNumber String

  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  status String @default("draft") // draft | submitted | under_review | shortlisted | interview_scheduled | interviewed | selected | rejected | withdrawn

  assignedRecruiterId String?
  assignedRecruiter   User?   @relation("AssignedRecruiter", fields: [assignedRecruiterId], references: [id])

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fieldValues ApplicationFieldValue[]
  documents   Document[]
  interviews  Interview[]

  @@unique([tenantId, applicationNumber])
  @@index([tenantId, jobId])
  @@index([tenantId, status])
  @@index([candidateId])
  @@map("applications")
}

// EAV-style storage for dynamic form answers. `valueJson` carries structured
// values (multiselect arrays, repeated entries); `valueText`/`valueNumber`
// are populated alongside for fast filtering/sorting lookups.
model ApplicationFieldValue {
  id            String @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fieldId String
  field   FormField @relation(fields: [fieldId], references: [id])

  valueText   String?
  valueNumber Float?
  valueJson   String?

  updatedAt DateTime @updatedAt

  @@unique([applicationId, fieldId])
  @@index([applicationId])
  @@index([fieldId])
  @@map("application_field_values")
}

// Document metadata + external reference (e.g. a Google Drive link, matching
// the current process). Actual file upload/storage can be added later by
// populating `storageUrl` from a new upload pipeline without changing this
// model's shape.
model Document {
  id            String @id @default(cuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  documentType String // admin-defined label, e.g. "Photograph", "10+2 Certificate"
  fileName     String?
  externalUrl  String? // e.g. Google Drive link
  storageUrl   String? // reserved for future first-party file storage

  verified   Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?

  uploadedAt DateTime @default(now())

  @@index([tenantId, applicationId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Interviews
// ---------------------------------------------------------------------------

// An application can have more than one of these over time (rescheduled,
// or a second round) — the UI only ever surfaces the latest non-cancelled
// one as "the" interview, but history is kept rather than overwritten.
// Panelists are free text, not linked User records: no login/user-
// management flow exists yet to pick real panel_member accounts from, so
// forcing a User link here would just block scheduling on a feature that
// doesn't exist. Revisit once that's built.
model Interview {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  scheduledAt     DateTime
  durationMinutes Int     @default(30)
  mode            String  @default("in_person") // in_person | video | phone — see src/lib/enums.ts
  location        String? // room/address for in_person, a join link for video, a number for phone
  panelistNames   String? // free-text, e.g. "Dr. A Sharma, Prof. B Singh"
  notes           String?

  status String @default("scheduled") // scheduled | completed | cancelled | no_show — see src/lib/enums.ts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([applicationId])
  @@map("interviews")
}

// ---------------------------------------------------------------------------
// Audit trail (also serves as the per-application activity timeline)
// ---------------------------------------------------------------------------

model AuditLog {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id])
  actorName String // denormalized so logs remain readable if the user is later removed

  action       String // e.g. application.submitted, document.uploaded, status.changed
  entityType   String // e.g. Application, Job, Document
  entityId     String
  metadataJson String?

  createdAt DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
